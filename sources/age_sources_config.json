                                                              "iframeSelector":  "(function(){\nfunction mediaOk(u){if(typeof u!=\u0027string\u0027||u.indexOf(\u0027http\u0027)!=0)return \u0027\u0027;if(u.indexOf(\u0027.m3u8\u0027)\u003e=0||u.indexOf(\u0027.mp4\u0027)\u003e=0||u.indexOf(\u0027.flv\u0027)\u003e=0)return u;return \u0027\u0027;}\nfunction urlOk(u){if(typeof u!=\u0027string\u0027)return \u0027\u0027;if(u.indexOf(\u0027https://\u0027)==0||u.indexOf(\u0027http://\u0027)==0)return u;return \u0027\u0027;}\nfunction decryptOk(u){var r=urlOk(u);if(!r)return \u0027\u0027;if(r.indexOf(\u0027.html\u0027)\u003e0||r.indexOf(\u0027.php\u0027)\u003e0||r.indexOf(\u0027.shtm\u0027)\u003e0)return \u0027\u0027;try{if(location.origin\u0026\u0026r.indexOf(location.origin)===0)return \u0027\u0027;}catch(e){}return r;}\nfunction perfM3u8(){try{var es=performance.getEntriesByType(\u0027resource\u0027);for(var i=es.length-1;i\u003e=0;i--){var n=es[i].name;if(n\u0026\u0026n.indexOf(\u0027http\u0027)==0\u0026\u0026n.indexOf(\u0027.m3u8\u0027)\u003e=0)return n;}}catch(e){}return \u0027\u0027;}\nfunction artTry(){try{\nvar A=window.Artplayer||window.ArtPlayer;\nif(A\u0026\u0026A.instances\u0026\u0026A.instances.length){\nfor(var i=0;i\u003cA.instances.length;i++){\nvar a=A.instances[i];\nvar u1=(a\u0026\u0026a.option\u0026\u0026typeof a.option.url==\u0027string\u0027)?a.option.url:\u0027\u0027;\nvar u2=(a\u0026\u0026a.hls\u0026\u0026typeof a.hls.url==\u0027string\u0027)?a.hls.url:\u0027\u0027;\nvar r=urlOk(u1)||urlOk(u2);\nif(r)return r;\n}}\n}catch(e){}return \u0027\u0027;}\nfunction syncTry(){var f=document.querySelector(\u0027iframe#video\u0027);var r=mediaOk(f\u0026\u0026f.getAttribute(\u0027src\u0027));if(!r){var v=document.querySelector(\u0027#artplayer video, video\u0027);if(v){r=urlOk(v.currentSrc||v.src);}}if(!r){r=artTry();}if(!r){r=perfM3u8();}return r;}\nfunction wrapHxm(){\ntry{\nif(window.hxm_decrypt\u0026\u0026!window.__animeHxm){\nwindow.__animeHxm=1;\nvar od=window.hxm_decrypt;\nwindow.hxm_decrypt=function(x){\nvar res=od(x);\ntry{var d=res;try{d=decodeURIComponent(String(res));}catch(e2){}var m=decryptOk(d)||decryptOk(String(res))||mediaOk(String(res));if(m)post(m);}catch(e){}\nreturn res;\n};\nreturn true;\n}\n}catch(e){}\nreturn false;\n}\nfunction post(u){try{window.animeBridge.onLink(u);}catch(e){}}\nvar R=syncTry();\nif(R){return R;}\nif(!window.__animeHook){\nwindow.__animeHook=1;\ntry{var oo=XMLHttpRequest.prototype.open;XMLHttpRequest.prototype.open=function(m,u){try{var s=String(u);if(s.indexOf(\u0027http\u0027)==0\u0026\u0026s.indexOf(\u0027.m3u8\u0027)\u003e=0){post(s);}}catch(e){}return oo.apply(this,arguments);};}catch(e){}\ntry{var of=window.fetch;window.fetch=function(){try{var a=arguments[0];var s=(typeof a==\u0027string\u0027)?a:((a\u0026\u0026a.url)||\u0027\u0027);if(s\u0026\u0026s.indexOf(\u0027http\u0027)==0\u0026\u0026s.indexOf(\u0027.m3u8\u0027)\u003e=0){post(s);}}catch(e){}return of.apply(this,arguments);};}catch(e){}\nif(!wrapHxm()){var hv=setInterval(function(){if(wrapHxm()){clearInterval(hv);}},400);setTimeout(function(){clearInterval(hv);},15000);}\nsetTimeout(function(){\ntry{\nif(window.__animeRedrive)return;\nvar A=window.Artplayer||window.ArtPlayer;\nif(A\u0026\u0026A.instances\u0026\u0026A.instances.length)return;\nif(document.querySelector(\u0027iframe#video\u0027))return;\nif(document.querySelector(\u0027#error\u0027))return;\nif(typeof window.hxm_encrypt==\u0027function\u0027\u0026\u0026typeof window.ajax_api==\u0027function\u0027){\nwindow.__animeRedrive=1;\nwindow.ajax_api();\n}\n}catch(e){}\n},8000);\nvar iv=setInterval(function(){var r=syncTry();if(r){clearInterval(iv);post(r);return;}if(document.querySelector(\u0027#error\u0027)){clearInterval(iv);post(\u0027ERR_SITE_BADRESP\u0027);}},500);\nsetTimeout(function(){clearInterval(iv);},110000);\n}\nreturn \u0027PENDING\u0027;\n})()"
