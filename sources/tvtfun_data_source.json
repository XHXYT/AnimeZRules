      "key": "key_tvtfun",
      "name": "天天番",
      "group": "动漫",
      "baseUrl": "https://www.tvtfun.net",
      "version": "1.0.1",
      "enabled": true,
      "priority": 15,
      "description": "天天番 tvtfun.net（JSON API 源；播放地址通过隐藏 WebView 在站点播放页内解析，需设备网络可正常访问站点）",
      "defaultSource": false,
      "parserConfig": {
        "sourceType": "json",
        "requestHeaders": {
          "Accept": "application/json",
          "RSC": "1"
        },
        "search": {
          "videos": {
            "urlTemplate": "/api/videos/search?q={keyword}&pageSize=20",
            "listSelector": "data.videos",
            "urlNeedBaseUrl": false,
            "enabledHttps": true,
            "itemSelectors": {
              "title": "{name}",
              "url": "{baseUrl}/api/videos/{id}",
              "imgUrl": {
                "selector": "{pic}",
                "postProcess": {
                  "type": "string",
                  "stringProcess": {
                    "type": "replace",
                    "search": "^https://lain\\.bgm\\.tv/(.+)$",
                    "replace": "https://www.tvtfun.net/_next/image?w=640&q=75&url=https://lain.bgm.tv/$1",
                    "flags": ""
                  }
                }
              },
              "episode": "{remarks}"
            }
          }
        },
        "homepage": {
          "banner": {
            "urlTemplate": "/",
            "listSelector": "regex:\"data\":\\{\"items\":(\\[[\\s\\S]*?\\])\\},\"type\":\"video-banner\"",
            "urlNeedBaseUrl": false,
            "enabledHttps": true,
            "itemSelectors": {
