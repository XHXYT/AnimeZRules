      "version": "1.0.0",
      "name": "MuteFun",
      "group": "动漫",
      "baseUrl": "https://www.2kdm.com",
      "enabled": true,
      "priority": 24,
      "description": "MuteFun 无声动漫 www.2kdm.com，搜索需图片验证码",
      "defaultSource": false,
      "parserConfig": {
        "search": {
          "videos": {
            "urlTemplate": "/vodsearch/-------------.html?wd={keyword}",
            "listSelector": "div.module-card-item",
            "urlNeedBaseUrl": true,
            "enabledHttps": true,
            "itemSelectors": {
              "url": "a.module-card-item-poster@href",
              "imgUrl": "img@data-original",
              "title": ".module-card-item-title strong",
              "episode": ".module-item-note"
            }
          },
          "captcha": {
            "detectSelector": "input.mac_verify",
            "imageUrlSelector": "",
            "imageUrlTemplate": "/index.php/verify/index.html?",
            "imageCacheBustParam": "r",
            "verifyUrlTemplate": "/index.php/ajax/verify_check?type=search&verify={code}",
            "successContains": "\"code\":1"
          }
        },
        "homepage": {
          "banner": {
            "urlTemplate": "",
            "listSelector": ".sm-swiper .swiper-slide",
            "urlNeedBaseUrl": true,
            "enabledHttps": true,
            "itemSelectors": {
              "url": "a@href",
              "imgUrl": "img@src",
              "title": ".title",
              "episode": ".ins p"
            }
          },
          "category": {
            "title": "",
            "titles": "",
            "moreUrl": "",
            "moreUrlNeedBaseUrl": false,
            "videoLists": "",
            "videos": {
              "urlTemplate": "",
              "listSelector": "a.module-poster-item",
              "urlNeedBaseUrl": true,
              "enabledHttps": true,
              "itemSelectors": {
                "url": "@href",
                "imgUrl": "img@data-original",
                "title": ".module-poster-item-title",
                "episode": ".module-item-note"
              }
            },
            "cards": [
              {
                "title": "日漫",
                "url": "/vodtype/20.html",
                "moreUrl": "",
