                "enabledHttps": true,
                "itemSelectors": {
                  "url": "@href",
                  "imgUrl": "img@data-original",
                  "title": ".module-poster-item-title",
                  "episode": ".module-item-note"
                }
              },
              {
                "title": "特摄",
                "url": "/vodtype/25.html",
                "moreUrl": "",
                "listSelector": "a.module-poster-item",
                "maxItems": 12,
                "urlNeedBaseUrl": true,
                "enabledHttps": true,
                "itemSelectors": {
                  "url": "@href",
                  "imgUrl": "img@data-original",
                  "title": ".module-poster-item-title",
                  "episode": ".module-item-note"
                }
              },
              {
                "title": "日剧",
                "url": "/vodtype/26.html",
                "moreUrl": "",
