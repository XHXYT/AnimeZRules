        "schedule": {
          "urlTemplate": "/milimili.platform.v1.PlatformService/ListBangumiCalendar",
          "method": "POST",
          "body": "{\"weekday\":{weekday},\"limit\":100}",
          "listSelector": "videos",
          "urlNeedBaseUrl": false,
          "enabledHttps": true,
          "itemSelectors": {
            "title": "{title}",
            "url": "{shortId}",
            "imgUrl": "{thumbnailUrl}",
            "episode": "{managedEpisodeCount}话"
          }
        },
        "detail": {
          "urlTemplate": "/milimili.platform.v1.PlatformService/GetBangumi",
          "method": "POST",
          "body": "{\"shortId\":\"{link}\"}",
          "dataPath": "",
          "titleSelector": "{video.title}",
          "descSelector": "{video.summary}",
          "coverSelector": "{video.thumbnailUrl}",
          "categorySelector": "{video.sectionName}",
          "directorSelector": "{video.bangumiMetadata.directors}",
          "updateTimeSelector": "{video.publishedAt}",
          "episodes": {
            "jsonListPath": "episodes",
            "jsonRouteTitleTemplate": "{video.title}",
            "itemSelector": "",
            "itemSelectors": {
              "title": "第{episodeLabel}话",
              "url": "https://milimili.moe/watch?ep={ep}"
            }
          },
          "recommends": {"jsonUrlTemplate":"/milimili.platform.v1.PlatformService/GetRecommendations","method":"POST","body":"{\"placements\":[\"related\"],\"sectionSlug\":\"{video.sectionSlug}\",\"sourceId\":\"{video.id}\",\"limit\":6}","listSelector":"boards.0.items","urlNeedBaseUrl":false,"enabledHttps":true,"itemSelectors":{"title":"{video.title}","url":"{video.shortId}","imgUrl":"{video.thumbnailUrl}","episode":"{video.managedEpisodeCount}话"}}
        },
        "videoUrl": {
          "pattern": "json",
          "urlTemplate": "/milimili.platform.v1.PlatformService/GetEpisode",
          "method": "POST",
          "body": "{\"ep\":\"{link#^.*[?&]ep=(\\d+).*$#$1}\",\"versionId\":\"\",\"playbackKey\":\"\",\"client\":\"web\"}",
          "valuePath": "episode.mediaUrl"
        }
      }
