      "defaultSource": false,
      "login": {
        "type": "cookie",
        "loginUrl": "/milimili.platform.v1.PlatformService/Login",
        "usernameField": "handle",
        "passwordField": "password",
        "extraBody": {
          "keepLoggedIn": true
        },
        "authHeaderName": "Cookie",
        "authValueTemplate": "{token}"
      },
      "parserConfig": {
        "sourceType": "json",
        "requestHeaders": {
          "Accept": "application/json",
          "Connect-Protocol-Version": "1"
        },
        "search": {
          "videos": {
            "urlTemplate": "/milimili.platform.v1.PlatformService/SearchVideos",
            "method": "POST",
            "body": "{\"query\":\"{keyword}\",\"limit\":50,\"sectionSlug\":\"anime\",\"contentType\":\"pgc\"}",
            "listSelector": "videos",
            "urlNeedBaseUrl": false,
            "enabledHttps": true,
            "itemSelectors": {
              "title": "{title}",
              "url": "{shortId}",
              "imgUrl": "{thumbnailUrl}",
              "episode": "{managedEpisodeCount}话"
            }
          }
        },
        "homepage": {
          "banner": {
            "urlTemplate": "/milimili.platform.v1.PlatformService/SearchVideos",
            "method": "POST",
            "body": "{\"query\":\"\",\"limit\":6,\"sectionSlug\":\"anime\",\"contentType\":\"pgc\"}",
            "listSelector": "videos",
            "urlNeedBaseUrl": false,
            "enabledHttps": true,
            "itemSelectors": {
              "title": "{title}",
              "url": "{shortId}",
              "imgUrl": "{thumbnailUrl}",
              "episode": "{managedEpisodeCount}话"
            }
          },
          "category": {
            "title": "",
            "titles": "",
            "moreUrl": "",
            "moreUrlNeedBaseUrl": false,
            "videoLists": "",
            "videos": {
              "urlTemplate": "",
              "listSelector": "videos",
              "urlNeedBaseUrl": false,
              "enabledHttps": true,
              "itemSelectors": {
                "title": "{title}",
                "url": "{shortId}",
                "imgUrl": "{thumbnailUrl}",
                "episode": "{managedEpisodeCount}话"
              }
            },
            "cards": [
              {
                "title": "最新番剧",
                "url": "/milimili.platform.v1.PlatformService/SearchVideos",
                "method": "POST",
                "body": "{\"query\":\"\",\"limit\":50,\"sectionSlug\":\"anime\",\"contentType\":\"pgc\"}",
                "listPath": "videos",
                "urlNeedBaseUrl": false,
                "enabledHttps": true,
                "itemSelectors": {
                  "title": "{title}",
                  "url": "{shortId}",
                  "imgUrl": "{thumbnailUrl}",
                  "episode": "{managedEpisodeCount}话"
                }
              },
              {
                "title": "最新电影",
                "url": "/milimili.platform.v1.PlatformService/SearchVideos",
                "method": "POST",
                "body": "{\"query\":\"\",\"limit\":50,\"sectionSlug\":\"movie\",\"contentType\":\"pgc\"}",
                "listPath": "videos",
                "urlNeedBaseUrl": false,
                "enabledHttps": true,
                "itemSelectors": {
