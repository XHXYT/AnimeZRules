                  "episode": "{managedEpisodeCount}话"
                }
              },
              {
                "title": "本季新番",
                "url": "/milimili.platform.v1.PlatformService/ListBangumiCalendar",
                "method": "POST",
                "body": "{\"weekday\":0,\"limit\":50}",
                "listPath": "videos",
                "urlNeedBaseUrl": false,
                "enabledHttps": true,
                "itemSelectors": {
                  "title": "{title}",
                  "url": "{shortId}",
                  "imgUrl": "{thumbnailUrl}",
                  "episode": "{managedEpisodeCount}话"
